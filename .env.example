# Copie para .env e ajuste. Nunca versione o .env com URLs reais.

# Webhook do Teams usado quando a demanda não tem responsável com canal próprio
# (Teams > canal > Workflows > "Post to a channel when a webhook request is received").
TEAMS_WEBHOOK_PADRAO=

# Endereço do painel usado no botão "Abrir no painel" dos cartões do Teams.
LEGALFLOW_URL_PAINEL=http://localhost:8501

# Dias antes do vencimento em que o alerta "vence em breve" é enviado.
LEGALFLOW_DIAS_ALERTA=3
# Intervalo (horas) para repetir o alerta de prazo vencido.
LEGALFLOW_HORAS_REPETICAO_VENCIDA=24
# Horas sem prazo definido até gerar o alerta "prazo a definir".
LEGALFLOW_HORAS_PRAZO_A_DEFINIR=24

# Versão da imagem do n8n (fixada na linha 1.x, cujos comandos de importação/ativação os fluxos usam).
N8N_VERSAO=1.123.93
